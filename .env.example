# ─── Claude (generazione + fact-check) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Instagram (Graph API) ────────────────────────────────────────────────────
# Come ottenerli: vedi README, sezione "Setup Instagram"
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAG...

# ─── Hosting immagini (serve URL pubblici SENZA query string) ─────────────────
# backend: github | cloudinary | local
IMAGE_HOST_BACKEND=github

# --- se backend=github ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=tuo-username/curiosity-cdn
GITHUB_BRANCH=main

# --- se backend=cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── TikTok (fase 2 — vedi README) ────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─── Telegram (opzionale: coda di approvazione + alert) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Immagini ─────────────────────────────────────────────────────────────────
# Ricerca foto (opzionale): senza chiave si usa Wikimedia Commons, che non ne
# richiede nessuna. Pexels dà una resa migliore sui soggetti generici.
PEXELS_API_KEY=

# Generazione AI (opzionale): serve solo se config.yaml → visuals.ai_provider
# è diverso da "none". Claude non genera immagini.
#
# ai_provider: "pollinations" → non serve nulla qui, funziona senza chiavi.
# ai_provider: "cloudflare"   → account gratuito, free tier generoso:
#   dash.cloudflare.com → Workers & Pages → l'Account ID è nell'URL o a destra;
#   il token si crea in My Profile → API Tokens con permesso "Workers AI: Read".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# A pagamento (richiedono fatturazione attiva sul progetto):
GEMINI_API_KEY=
OPENAI_API_KEY=
